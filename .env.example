# Copy this file to .env.local and fill in your real Supabase project values.
# Find both values in your Supabase project: Project Settings -> API.
# Both are safe to expose publicly (that's what NEXT_PUBLIC_ means) -- your data
# is protected by Row Level Security policies in the database, not by hiding
# these values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
